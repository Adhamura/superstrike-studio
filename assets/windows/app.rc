// Windows resources: application icon (shown by Explorer, taskbar, title bar) and version info.
#include <winver.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SUPERSTRIKE Studio contributors\0"
            VALUE "FileDescription", "SUPERSTRIKE Studio - settings editor for the Logitech PRO X3 SUPERSTRIKE\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "superstrike-studio\0"
            VALUE "OriginalFilename", "superstrike-studio.exe\0"
            VALUE "ProductName", "SUPERSTRIKE Studio\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
